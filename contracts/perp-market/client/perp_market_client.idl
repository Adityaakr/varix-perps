type MarketConfig = struct {
  owner: actor_id,
  asset: Asset,
  oracle_service: actor_id,
  margin_vault: actor_id,
  liquidity_pool: actor_id,
  session_registry: actor_id,
  risk: MarketRiskConfig,
};

type Asset = enum {
  Btc,
  Eth,
  Sol,
};

type MarketRiskConfig = struct {
  initial_margin_bps: u16,
  maintenance_margin_bps: u16,
  max_leverage: u16,
  funding_interval_blocks: u32,
  liquidation_delay_blocks: u32,
  max_funding_velocity_bps: i16,
};

type OpenPosition = struct {
  id: u64,
  trader: actor_id,
  position: Position,
};

type Position = struct {
  size: i128,
  entry_price: u128,
  margin: u128,
  leverage: u16,
  last_funding_rate_bps: i128,
  opened_at: u64,
};

type ClosedPosition = struct {
  realized_pnl: i128,
  funding_paid: i128,
  released_margin: u128,
  payout: u128,
  remaining_margin: u128,
};

type Side = enum {
  Long,
  Short,
};

type MarketSnapshot = struct {
  mark_price: u128,
  index_price: u128,
  funding_rate_bps: i128,
  cumulative_funding_rate_bps: i128,
  open_interest_long: u128,
  open_interest_short: u128,
};

type PositionLookup = struct {
  found: bool,
  position: OpenPosition,
};

constructor {
  Create : (config: MarketConfig, initial_mark_price: u128, initial_index_price: u128);
};

service Market {
  AddMargin : (position_id: u64, amount: u128) -> OpenPosition;
  CheckLiquidation : (trader: actor_id) -> bool;
  ClosePosition : (position_id: u64, size: u128) -> ClosedPosition;
  OpenPosition : (side: Side, size: u128, leverage: u16, margin: u128, max_slippage_bps: u16) -> OpenPosition;
  /// Owner-only: set the taker fee (basis points of traded notional) charged on
  /// position opens. `0` disables fees.
  SetFees : (taker_fee_bps: u16) -> u16;
  /// Owner-only: set the funding skew coefficient (basis points applied at a
  /// fully one-sided book). `0` falls back to pure premium funding.
  SetFundingSkew : (coefficient_bps: u16) -> u16;
  /// Owner-only: configure liquidations. `penalty_bps` is charged on the
  /// liquidated notional and routed to the insurance fund; `fraction_bps` is
  /// the share of a position closed per liquidation call (`0` or `>= 10_000`
  /// closes the whole position).
  SetLiquidationConfig : (penalty_bps: u16, fraction_bps: u16) -> null;
  /// Owner-only: cap the open interest allowed on each side of the book. `0`
  /// means uncapped.
  SetOiCap : (max_oi_per_side: u128) -> u128;
  /// Owner-only: bound how far a single `update_price` may move the mark/index
  /// from the previous value, in basis points. `0` disables the circuit breaker.
  SetPriceGuard : (max_price_deviation_bps: u16) -> u16;
  SettleFunding : () -> MarketSnapshot;
  UpdatePrice : (mark_price: u128, index_price: u128) -> MarketSnapshot;
  query Config : () -> MarketConfig;
  query FeeConfig : () -> u16;
  query FundingSkew : () -> u16;
  query LiquidationFractionBps : () -> u16;
  query LiquidationPenaltyBps : () -> u16;
  query MarketState : () -> MarketSnapshot;
  query OiCap : () -> u128;
  query Position : (position_id: u64) -> PositionLookup;
  query Positions : (trader: actor_id) -> vec OpenPosition;
  query PriceGuard : () -> u16;
};

