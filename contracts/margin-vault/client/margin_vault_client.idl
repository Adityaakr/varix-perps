type AccountSnapshot = struct {
  free: u128,
  locked: u128,
};

type VaultTotals = struct {
  total_free: u128,
  total_locked: u128,
};

constructor {
  Create : (owner: actor_id, session_registry: actor_id, token_program: actor_id);
};

service Vault {
  AuthorizeMarket : (market: actor_id) -> null;
  /// Deduct a trading fee from a trader's free balance and forward the tokens
  /// to the liquidity pool. Called by an authorized market on trade execution.
  /// Strict: fails if the trader's free balance cannot cover the full fee.
  ChargeFee : (trader: actor_id, amount: u128, pool: actor_id) -> AccountSnapshot;
  Deposit : (amount: u128) -> AccountSnapshot;
  LockMargin : (trader: actor_id, amount: u128) -> AccountSnapshot;
  ReleaseMargin : (trader: actor_id, amount: u128) -> AccountSnapshot;
  RevokeMarket : (market: actor_id) -> null;
  SettlePosition : (trader: actor_id, released_margin: u128, payout: u128, pool: actor_id) -> AccountSnapshot;
  SlashForLiquidation : (trader: actor_id, amount: u128, pool: actor_id) -> AccountSnapshot;
  Withdraw : (amount: u128) -> AccountSnapshot;
  query Account : (trader: actor_id) -> AccountSnapshot;
  query Totals : () -> VaultTotals;
};

