{
  "name": "varix",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "start": "pnpm -r --parallel start",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "dev:web": "pnpm --filter @varix/web dev",
    "dev:indexer": "pnpm --filter @varix/indexer dev",
    "dev:oracle": "pnpm --filter @varix/oracle-relay dev",
    "dev:liq": "pnpm --filter @varix/liquidation-watcher dev",
    "dev:data": "pnpm --filter @varix/market-data-proxy dev"
  },
  "devDependencies": {
    "@types/node": "^24.5.2",
    "@types/ws": "^8.18.1",
    "tsx": "^4.20.3",
    "typescript": "^5.9.3"
  }
}
